---
import Layout from "../layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FAQ from "@/components/blocks/FAQ.astro";
---

<Layout
    title="FAQs - Upgrade CMS"
    description="Frequently asked questions about Upgrade CMS"
>
    <Header />
    <main>
        <section class="py-24 lg:py-32">
            <div class="container max-w-3xl text-center">
                <h1 class="text-4xl font-bold tracking-tight sm:text-6xl mb-6">
                    Frequently Asked Questions
                </h1>
                <p class="text-xl text-muted-foreground">
                    Find answers to common questions about Upgrade CMS.
                </p>
            </div>
        </section>

        <FAQ />

        <section class="py-24 bg-secondary/20">
            <div class="container max-w-3xl text-center">
                <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">
                    Still have questions?
                </h2>
                <p class="text-xl text-muted-foreground mb-8">
                    Can't find the answer you're looking for? Our support team
                    is here to help.
                </p>
                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a
                        href="#"
                        class="bg-primary text-primary-foreground hover:bg-primary/90 h-12 px-8 rounded-md inline-flex items-center justify-center whitespace-nowrap text-base font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                    >
                        Contact Support
                    </a>
                    <a
                        href="#"
                        class="border border-input bg-background hover:bg-accent hover:text-accent-foreground h-12 px-8 rounded-md inline-flex items-center justify-center whitespace-nowrap text-base font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                    >
                        Join Community
                    </a>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
