---
import Layout from "../../layouts/Layout.astro";
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import { formatDate } from "@/utils/formatDate";
import { getCollection, render } from "astro:content";
import fs from "node:fs";

// Inlined rather than <img src="/svg/robot.svg"> so the icon inherits
// currentColor from the surrounding text — an <img> would render it black
// regardless of theme. Sizing comes from the wrapper, not the file.
const robotIcon = fs
    .readFileSync(new URL("../../../public/svg/robot.svg", import.meta.url), "utf-8")
    .replace(/\s(?:width|height)="\d+"/g, "");

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, pubDate, author, readTime, youtubeUrl, aiDeclaration } =
    post.data;

const formattedDate = pubDate ? formatDate(pubDate) : null;
---

<Layout
    title={`${title} - Kevin Galligan`}
    description={post.data.excerpt || `${title} - Kevin Galligan`}
>
    <article class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
        <a
            href="/blog"
            class="font-mono text-xs text-ink-soft transition-colors hover:text-signal"
        >
            ← All posts
        </a>

        <h1
            class="mt-6 max-w-2xl font-display text-3xl font-medium text-ink sm:text-4xl"
        >
            {title}
        </h1>

        <dl
            class="mt-6 flex flex-wrap gap-x-8 gap-y-2 border-y border-line py-4 font-mono text-xs text-ink-soft"
        >
            <div><dt class="inline">By —</dt><dd class="inline"> {author}</dd></div>
            {
                pubDate && (
                    <div>
                        <dt class="inline">Date —</dt>
                        <dd class="inline">
                            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
                        </dd>
                    </div>
                )
            }
            {
                readTime && (
                    <div>
                        <dt class="inline">Length —</dt>
                        <dd class="inline"> {readTime}</dd>
                    </div>
                )
            }
        </dl>

        {
            youtubeUrl && (
                <div class="mt-10">
                    <YouTubeEmbed url={youtubeUrl} title={title} />
                </div>
            )
        }

        {
            aiDeclaration && (
                <p class="mt-10 flex items-start gap-2 text-sm italic text-ink-soft">
                    <span class="group relative inline-flex shrink-0" tabindex="0">
                        <span
                            class="text-ai-accent [&>svg]:h-8 [&>svg]:w-8"
                            aria-hidden="true"
                            set:html={robotIcon}
                        />
                        <span
                            role="tooltip"
                            class="pointer-events-none absolute bottom-full left-0 z-10 mb-2 w-max max-w-64 rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs not-italic text-ink opacity-0 shadow-md transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100"
                        >
                            AI was used for content on this page
                        </span>
                    </span>
                    <span>{aiDeclaration}</span>
                </p>
            )
        }

        <div class="prose prose-sm sm:prose-base mt-10 max-w-none">
            <Content />
        </div>

        <footer class="mt-16 border-t border-line pt-8">
            <a
                href="/blog"
                class="font-mono text-xs text-ink-soft transition-colors hover:text-signal"
            >
                ← All posts
            </a>
        </footer>
    </article>
</Layout>
