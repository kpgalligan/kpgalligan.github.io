---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import PostRow from "@/components/PostRow.astro";
import { getCollection } from "astro:content";

// Get all blog posts and sort by date (newest first)
const allPosts = await getCollection("blog");
const posts = allPosts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Extract unique categories for filter buttons
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<Layout
    title="Writing & talks - Kevin Galligan"
    description="Talks and writing on native mobile development, Kotlin Multiplatform, and AI-assisted engineering."
>
    <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
        <p class="mb-6 font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">
            Writing &amp; talks
        </p>

        <h1
            class="max-w-xl font-display text-3xl font-medium text-ink sm:text-4xl"
        >
            Talks and writing on native mobile development, Kotlin
            Multiplatform, and AI-assisted engineering.
        </h1>

        <div class="mt-10 mb-10 flex flex-wrap gap-2" id="category-filters">
            <button
                class="category-btn rounded-full border border-signal bg-signal px-3 py-1 font-mono text-xs text-paper transition-colors"
                data-category="all"
            >
                All
            </button>
            {
                categories.map((category) => (
                    <button
                        class="category-btn rounded-full border border-line px-3 py-1 font-mono text-xs text-ink-soft transition-colors hover:border-signal hover:text-signal"
                        data-category={category}
                    >
                        {category}
                    </button>
                ))
            }
        </div>

        <SectionHeading eyebrow="All posts" count={posts.length} />

        <div id="posts-container">
            {posts.map((post) => <PostRow post={post} />)}
        </div>
    </section>
</Layout>

<script>
    // Category filter. Rows are `display: grid`, so toggle the inline style
    // back to "" rather than "block" — "block" would collapse the columns.
    const filterButtons =
        document.querySelectorAll<HTMLButtonElement>(".category-btn");
    const postCards = document.querySelectorAll<HTMLElement>(".post-card");

    const activeClasses = ["border-signal", "bg-signal", "text-paper"];
    const idleClasses = [
        "border-line",
        "text-ink-soft",
        "hover:border-signal",
        "hover:text-signal",
    ];

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const category = button.dataset.category;

            filterButtons.forEach((btn) => {
                btn.classList.remove(...activeClasses);
                btn.classList.add(...idleClasses);
            });
            button.classList.remove(...idleClasses);
            button.classList.add(...activeClasses);

            postCards.forEach((card) => {
                const matches =
                    category === "all" || card.dataset.category === category;
                card.style.display = matches ? "" : "none";
            });
        });
    });
</script>
