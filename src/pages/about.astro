---
import Layout from "../layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Timeline from "@/components/blocks/Timeline.astro";
---

<Layout
    title="About - Kevin Galligan"
    description="Kevin Galligan - software engineer, leader, and entrepreneur. New York, NY."
>
    <Header />
    <main>
        <section class="py-24 lg:py-32">
            <div class="container max-w-3xl">
                <div class="mb-16">
                    <h1
                        class="text-4xl font-bold tracking-tight sm:text-6xl mb-6"
                    >
                        Kevin Galligan
                    </h1>
                    <p class="text-xl text-muted-foreground mb-4">
                        I've been coding for decades. My Mom taught me Basic when I was 7, and I've been doing it more or less since then. I've started businesses, managed dev teams, and done a whole lot of open source and content over the years.
                    </p>
                    <p class="text-xl text-muted-foreground mb-4">
                    I love making things.
                    </p>
                    <p class="text-xl text-muted-foreground mb-4">
                    Currently focused on how AI will reshape mobile development, but also AI development in general.
                    </p>
                </div>

                <Timeline />
            </div>
        </section>
    </main>
    <Footer />
</Layout>
