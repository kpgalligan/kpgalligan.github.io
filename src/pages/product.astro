---
import Layout from "../layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FeatureGrid from "@/components/blocks/FeatureGrid.astro";
---

<Layout
    title="Product - Upgrade CMS"
    description="Discover all the features and capabilities of Upgrade CMS"
>
    <Header />
    <main>
        <section class="py-24 lg:py-32">
            <div class="container">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h1
                        class="text-4xl font-bold tracking-tight sm:text-6xl mb-6"
                    >
                        Built for developers.<br />Loved by teams.
                    </h1>
                    <p class="text-xl text-muted-foreground">
                        Upgrade CMS is a modern, API-first content management
                        system designed to give developers full control while
                        keeping content editors happy.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto mb-24"
                >
                    <div class="space-y-4">
                        <div
                            class="h-12 w-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-6 w-6"
                                ><polyline points="16 18 22 12 16 6"
                                ></polyline><polyline points="8 6 2 12 8 18"
                                ></polyline></svg
                            >
                        </div>
                        <h3 class="text-2xl font-bold">
                            API-First Architecture
                        </h3>
                        <p class="text-muted-foreground">
                            RESTful and GraphQL APIs out of the box. Build your
                            frontend with any framework - Next.js, Astro, Vue,
                            Svelte, or anything else.
                        </p>
                    </div>

                    <div class="space-y-4">
                        <div
                            class="h-12 w-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-6 w-6"
                                ><path d="M12 2v20M2 12h20"></path></svg
                            >
                        </div>
                        <h3 class="text-2xl font-bold">
                            Flexible Content Modeling
                        </h3>
                        <p class="text-muted-foreground">
                            Create custom content types with a powerful schema
                            builder. Support for rich text, media, relations,
                            and custom field types.
                        </p>
                    </div>

                    <div class="space-y-4">
                        <div
                            class="h-12 w-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-6 w-6"
                                ><path
                                    d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                ></path><circle cx="9" cy="7" r="4"
                                ></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"
                                ></path><path d="M16 3.13a4 4 0 0 1 0 7.75"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-2xl font-bold">Team Collaboration</h3>
                        <p class="text-muted-foreground">
                            Real-time collaboration, role-based permissions,
                            content workflows, and version history keep your
                            team in sync.
                        </p>
                    </div>

                    <div class="space-y-4">
                        <div
                            class="h-12 w-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-6 w-6"
                                ><rect
                                    width="18"
                                    height="11"
                                    x="3"
                                    y="11"
                                    rx="2"
                                    ry="2"></rect><path
                                    d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
                            >
                        </div>
                        <h3 class="text-2xl font-bold">Enterprise Security</h3>
                        <p class="text-muted-foreground">
                            Built-in authentication, SSO support, audit logs,
                            and granular permissions ensure your content stays
                            secure.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <FeatureGrid />

        <section class="py-24 bg-secondary/20">
            <div class="container max-w-4xl">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl font-bold tracking-tight sm:text-4xl mb-4"
                    >
                        Developer Experience First
                    </h2>
                    <p class="text-muted-foreground text-lg">
                        Built by developers, for developers. Every feature is
                        designed with DX in mind.
                    </p>
                </div>

                <div class="bg-card border border-border rounded-lg p-6">
                    <pre
                        class="text-sm overflow-x-auto"><code>// Fetch content with our TypeScript SDK
import &#123; UpgradeClient &#125; from '@upgrade/sdk';

const client = new UpgradeClient(&#123;
  apiKey: process.env.UPGRADE_API_KEY
&#125;);

// Type-safe content fetching
const posts = await client.posts.findMany(&#123;
  where: &#123; published: true &#125;,
  orderBy: &#123; publishedAt: 'desc' &#125;,
  include: &#123; author: true &#125;
&#125;);

// Full TypeScript support
posts.forEach(post =&gt; &#123;
  console.log(post.title, post.author.name);
&#125;);</code></pre>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
