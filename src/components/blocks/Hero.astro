---
import Button from "@/components/Button.astro";
import { SITE } from "@/site.config";
---

<section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <p class="mb-6 inline-flex items-center gap-2 font-mono text-xs text-ink-soft">
        <span class="h-1.5 w-1.5 rounded-full bg-signal" aria-hidden="true"></span>
        {SITE.location}
    </p>

    <h1
        class="max-w-2xl font-display text-4xl font-medium leading-[1.1] text-ink sm:text-5xl"
    >
        {SITE.name}
    </h1>

    <p class="mt-6 max-w-xl text-ink-soft">
        Engineer, engineering leader, and founder. I've been building Android
        since before there were Android phones, and spent the years since
        running a mobile consultancy, leading teams, and shipping the tooling
        underneath other people's apps.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/blog" variant="solid">Writing &amp; talks →</Button>
    </div>
</section>
