---
const links = [
    { href: "/blog", label: "Writing & talks", primary: false },
];
---

<section
    class="relative flex flex-col items-center justify-center py-24 lg:py-32 text-center overflow-hidden"
>
    <div class="container relative z-10 flex flex-col items-center gap-8">
        <div
            class="inline-flex items-center rounded-full border px-4 py-1.5 text-sm font-normal text-muted-foreground backdrop-blur-sm"
        >
            New York, NY
        </div>

        <h1
            class="text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl max-w-4xl text-balance"
        >
            Kevin Galligan
        </h1>

        <p
            class="max-w-2xl text-lg text-muted-foreground sm:text-xl text-balance"
        >
            Engineer, engineering leader, and founder. I've been building
            Android since before there were Android phones, and spent the years
            since running a mobile consultancy, leading teams, and shipping the
            tooling underneath other people's apps.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class={
                            link.primary
                                ? "bg-primary text-primary-foreground hover:bg-primary/90 h-12 px-8 rounded-md inline-flex items-center justify-center whitespace-nowrap text-base font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                                : "border border-input bg-background hover:bg-accent hover:text-accent-foreground h-12 px-8 rounded-md inline-flex items-center justify-center whitespace-nowrap text-base font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                        }
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>
    </div>

    <!-- Background glow effect -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-primary/5 rounded-full blur-3xl -z-10 pointer-events-none"
    >
    </div>
</section>
