---
import { Badge } from "@/components/ui/badge";
import { Clock } from "lucide-react";

const items = [
    {
        status: "In Progress",
        title: "Live preview editing",
        description:
            "Let content editors preview their changes in real-time within the CMS editor.",
        eta: "Beta by May 2025",
        team: "Core Team",
    },
    {
        status: "In Progress",
        title: "SvelteKit plugin",
        description: "First-class Upgrade support for SvelteKit via a plugin.",
        eta: "Q2 2025",
        team: "Core Team",
    },
    {
        status: "Planned",
        title: "API tokens with granular scopes",
        description:
            "Create multiple tokens with read/write/scope-level permissions for teams and external services.",
        eta: "Q3 2025",
        team: "Core Team",
    },
    {
        status: "Planned",
        title: "Image editor field type",
        description:
            "Add support for cropping, aspect ratios, alt-text, and focal point control in media uploads.",
        eta: "Q3 2025",
        team: "Core Team",
    },
];

const getStatusColor = (status: string) => {
    switch (status) {
        case "In Progress":
            return "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 border-amber-200 dark:border-amber-800";
        case "Planned":
            return "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border-blue-200 dark:border-blue-800";
        case "Shipped":
            return "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 border-green-200 dark:border-green-800";
        default:
            return "bg-secondary text-secondary-foreground";
    }
};
---

<section class="py-24 bg-secondary/20">
    <div class="container">
        <div class="mb-12">
            <h2 class="text-3xl font-bold tracking-tight mb-4">Roadmap</h2>
            <div class="flex gap-4">
                <button
                    class="text-sm font-medium text-primary border-b-2 border-primary pb-1"
                    >All</button
                >
                <button
                    class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors pb-1"
                    >In Progress</button
                >
                <button
                    class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors pb-1"
                    >Planned</button
                >
                <button
                    class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors pb-1"
                    >Shipped</button
                >
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                items.map((item) => (
                    <div class="bg-card border border-border rounded-lg p-6 flex flex-col h-full">
                        <div class="flex items-center justify-between mb-4">
                            <span
                                class={`px-2.5 py-0.5 rounded-full text-xs font-medium border ${getStatusColor(item.status)}`}
                            >
                                {item.status}
                            </span>
                            <div class="flex items-center text-xs text-muted-foreground gap-1">
                                <Clock className="h-3 w-3" />
                                {item.eta}
                            </div>
                        </div>

                        <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
                        <p class="text-muted-foreground text-sm mb-6 flex-1">
                            {item.description}
                        </p>

                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-border/50">
                            <div class="flex items-center gap-2 text-xs font-medium">
                                <div class="h-5 w-5 rounded-full bg-primary/20 flex items-center justify-center">
                                    <div class="h-2 w-2 rounded-full bg-primary" />
                                </div>
                                {item.team}
                            </div>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-4 w-4 text-muted-foreground hover:text-primary cursor-pointer transition-colors"
                                ><path
                                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
                            >
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
