---
const plans = [
    {
        name: "Open Source",
        price: "$0",
        period: "/ forever",
        description: "Self-host on your own infrastructure",
        features: [
            "Full access to the Upgrade CMS core",
            "GitHub community support",
            "Ideal for developers and internal tools",
            "Unlimited projects",
        ],
        cta: "View on GitHub",
        variant: "outline",
    },
    {
        name: "Cloud",
        price: "From $29",
        period: "/ month",
        description: "Fully managed infrastructure",
        features: [
            "Realtime collaboration & autosave",
            "Role-based access & team permissions",
            "Built-in CDN for media delivery",
            "Email support & usage analytics",
        ],
        cta: "Start Free Trial",
        variant: "default",
    },
];
---

<section class="py-24">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-4">
                Start free. Scale confidently.
            </h2>
            <p class="text-muted-foreground text-lg">
                Choose the plan that fits your needs, from hobby projects to
                enterprise scale.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            {
                plans.map((plan) => (
                    <div class="flex flex-col p-8 bg-card border border-border rounded-xl shadow-sm hover:shadow-md transition-shadow">
                        <div class="mb-6">
                            <h3 class="text-2xl font-bold mb-2">{plan.name}</h3>
                            <div class="flex items-baseline gap-1">
                                <span class="text-4xl font-bold">
                                    {plan.price}
                                </span>
                                <span class="text-muted-foreground">
                                    {plan.period}
                                </span>
                            </div>
                            <p class="text-muted-foreground mt-2">
                                {plan.description}
                            </p>
                        </div>

                        <ul class="flex-1 space-y-4 mb-8">
                            {plan.features.map((feature) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="h-5 w-5 text-primary shrink-0"
                                    >
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                    <span class="text-sm">{feature}</span>
                                </li>
                            ))}
                        </ul>

                        <a
                            href="#"
                            class={
                                plan.variant === "outline"
                                    ? "border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 rounded-md inline-flex items-center justify-center whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 w-full"
                                    : "bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 rounded-md inline-flex items-center justify-center whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 w-full"
                            }
                        >
                            {plan.cta}
                        </a>
                    </div>
                ))
            }
        </div>
    </div>
</section>
