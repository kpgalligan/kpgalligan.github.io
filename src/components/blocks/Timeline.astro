---
import SectionHeading from "@/components/SectionHeading.astro";

const entries = [
    {
        range: "2024 – Present",
        title: "AI-native mobile",
        body: "Co-founded Ntive Labs with the Touchlab team leadership and went all in on figuring out how AI will impact mobile development. Building custom coding agent tools, at scale.",
    },
    {
        range: "2018 – 2024",
        title: "Kotlin Multiplatform",
        body: "Jumped into KMP at the beginning, and reshaped Touchlab to be the leading KMP shop. With the Touchlab team, shipped the first KMP app in the App Store, built much of the early foundational libraries and tools for the ecosystem. Highlights: SKIE, the Xcode/Kotlin plugin, native drivers for SqlDelight, CrashKiOS, KMMBridge. Endless conference talks and blog posts promoting the platform. Spent a lot of time embedded with client teams integrating KMP into their workflows.",
    },
    {
        range: "2011 – 2018",
        title: "Touchlab and the Android years",
        body: "Started Touchlab as New York's Android shop when nearly everyone else was building for iPhone. Grew the team, ran the NYC Android meetup. Rode StartupBus 2012 (https://www.youtube.com/watch?v=oeqTCpkGKoY). Launched Droidcon New York in 2014. Built apps for clients from startups to Fortune 500.",
    },
    {
        range: "2008 – 2011",
        title: "Lifestyle businesses, coworking, and early Android",
        body: "Built a business hosting large marketing datasets, with fast geographical searches. Only so many potential customers. Learned Android for fun. Submitted to the first Android Developer Contest. Did not win ;)",
    },
    {
        range: "2006 - 2008",
        title: "Startups",
        body: "Medical startup (short-lived), then trading system at a fintech.",
    },
    {
        range: "(Pre-history)",
        title: "Getting started",
        body: "Basic on a VIC-20, courtesy of my Mom and uncle Noel. C++ game hacking. Colgate for college, Java, finance at a bank.",
    },
];
---

<section class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Timeline" />

    <ol class="ml-3 space-y-10 border-l border-line">
        {
            entries.map((entry) => (
                <li class="relative pl-8">
                    <span
                        class="absolute -left-[4.5px] top-2 h-2 w-2 rounded-full bg-signal"
                        aria-hidden="true"
                    />
                    <p class="mb-1 font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">
                        {entry.range}
                    </p>
                    <h3 class="mb-2 font-display text-lg text-ink">
                        {entry.title}
                    </h3>
                    <p class="text-sm leading-relaxed text-ink-soft">
                        {entry.body}
                    </p>
                </li>
            ))
        }
    </ol>
</section>
