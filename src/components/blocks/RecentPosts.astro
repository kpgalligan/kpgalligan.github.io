---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<section class="py-24">
    <div class="container max-w-4xl">
        <div class="flex items-baseline justify-between mb-12">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
                Recent writing & talks
            </h2>
            <a href="/blog" class="text-primary hover:underline font-medium">
                View all →
            </a>
        </div>

        <div class="space-y-6">
            {
                posts.map((post) => (
                    <article class="bg-card border border-border rounded-lg p-6 hover:shadow-lg transition-shadow">
                        <div class="flex items-center gap-4 text-sm text-muted-foreground mb-3">
                            <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-medium">
                                {post.data.category}
                            </span>
                            {post.data.readTime && (
                                <span>{post.data.readTime}</span>
                            )}
                        </div>
                        <h3 class="text-xl font-bold mb-2 hover:text-primary transition-colors">
                            <a href={`/blog/${post.id}`}>{post.data.title}</a>
                        </h3>
                        <p class="text-muted-foreground">{post.data.excerpt}</p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
