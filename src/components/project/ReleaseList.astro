---
interface Props {
    releases: { version: string; title: string; body: string }[];
}

const { releases } = Astro.props;
---

<dl>
    {
        releases.map(({ version, title, body }) => (
            <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-6 border-b border-line py-5">
                <dt class="font-mono text-xs text-ink-soft">{version}</dt>
                <dd class="min-w-0">
                    <p class="font-display text-base text-ink">{title}</p>
                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">{body}</p>
                </dd>
            </div>
        ))
    }
</dl>
