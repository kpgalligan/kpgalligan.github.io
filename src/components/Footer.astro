---
import { SITE } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
    <div
        class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 font-mono text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between"
    >
        <p>&copy; {year} {SITE.name}. Built with Astro.</p>

        <nav class="flex flex-wrap items-center gap-4" aria-label="Social">
            {
                SITE.social.map((link) => (
                    <a
                        href={link.href}
                        rel="me noreferrer"
                        class="transition-colors hover:text-signal"
                    >
                        {link.label}
                    </a>
                ))
            }
            <a href="#top" class="transition-colors hover:text-signal">Top ↑</a>
        </nav>
    </div>
</footer>
